# ── Deployment ───────────────────────────────────────────────────────────────
IMAGE=ghcr.io/williamsrandrew/t3-docker:latest
DATA_DIR=./data
WORKSPACE_DIR=./workspace

# ── Container user ───────────────────────────────────────────────────────────
# Match the owner of DATA_DIR / WORKSPACE_DIR on the host (`id` / `ls -ln`).
PUID=1000
PGID=1000
TZ=America/Chicago
# Passwordless sudo for the dev user (and therefore for agents).
ALLOW_SUDO=true

# ── T3 Code ──────────────────────────────────────────────────────────────────
# The address your other devices use to reach this box. Pairing links point here.
T3_PUBLIC_URL=http://192.168.2.30:3773
# How long pairing links from `t3-pair` stay valid.
T3_PAIR_TTL=30m
# Username/password login for browsers instead of pairing links. Empty password = pairing only.
T3_LOGIN_USER=dev
T3_LOGIN_PASSWORD=
T3_LOGIN_DAYS=365

# ── Web terminal (ttyd) ──────────────────────────────────────────────────────
# user:password for HTTP basic auth. Left empty, the web terminal stays off.
TTYD_CREDENTIAL=
TTYD_ENABLE=true

# ── Git / GitHub ─────────────────────────────────────────────────────────────
GIT_USER_NAME=
GIT_USER_EMAIL=
# Optional. Normally you run `gh auth login` once and it persists in the home volume.
# GH_TOKEN=

# ── Agent / service credentials (all optional) ───────────────────────────────
# Subscription logins (`claude auth login`, `codex login`) persist in the home
# volume and are usually better than API keys.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# VERCEL_TOKEN=

# ── Tuning ───────────────────────────────────────────────────────────────────
NODE_OPTIONS=--max-old-space-size=4096
# Set to true if /workspace is on SMB/NFS and dev-server file watching misses changes.
# CHOKIDAR_USEPOLLING=true
# WATCHPACK_POLLING=true
