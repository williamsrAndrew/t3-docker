#!/usr/bin/env bash
# Web terminal: a persistent tmux session ("main") behind HTTP basic auth.
set -euo pipefail
exec ttyd \
    --port "${TTYD_PORT:-7681}" \
    --writable \
    --credential "${TTYD_CREDENTIAL:?TTYD_CREDENTIAL must be set (user:password)}" \
    --ping-interval 30 \
    --index /usr/local/share/devbox/ttyd-index.html \
    --debug 3 \
    -t titleFixed="${TTYD_TITLE:-t3-dev}" \
    -t fontSize="${TTYD_FONT_SIZE:-14}" \
    -t disableLeaveAlert=true \
    tmux new-session -A -s main -c /workspace
