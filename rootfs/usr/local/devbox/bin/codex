#!/bin/sh
# `codex login` opens a localhost:1455 browser callback, which can't work on a
# remote server. T3's setup wizard runs exactly `codex login`, so turn that into
# the device-code flow (open a URL, enter a short code; nothing to paste back).
. /usr/local/devbox/bin/_next
real=$(devbox_next codex) || exit 127
if [ "$#" -eq 1 ] && [ "$1" = login ]; then
    exec "$real" login --device-auth
fi
exec "$real" "$@"
