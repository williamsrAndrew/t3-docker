# shellcheck shell=sh
# Sourced by the wrappers in this directory: prints the next `$1` on PATH after
# /usr/local/devbox/bin, so a copy you installed in your home folder still wins
# over the image's copy.
devbox_next() {
    _name="$1"
    _old_ifs="$IFS"; IFS=:
    for _dir in $PATH; do
        [ "$_dir" = /usr/local/devbox/bin ] && continue
        if [ -x "$_dir/$_name" ]; then IFS="$_old_ifs"; printf '%s\n' "$_dir/$_name"; return 0; fi
    done
    IFS="$_old_ifs"
    echo "devbox: $_name not found on PATH" >&2
    return 127
}
