#!/bin/sh
# Wrapper for Claude Code. `claude update` (and some in-app updaters) install a
# new version into ~/.npm-global without running its postinstall, which leaves a
# placeholder instead of the ~240MB native binary: every command then fails with
# "claude native binary not installed". Finish that install before running.
. /usr/local/devbox/bin/_next

heal() {
    pkg="$HOME/.npm-global/lib/node_modules/@anthropic-ai/claude-code"
    [ -f "$pkg/install.cjs" ] || return 0
    size=$(stat -c %s "$pkg/bin/claude.exe" 2>/dev/null || echo 0)
    [ "$size" -gt 10000000 ] && return 0
    echo "devbox: finishing the Claude Code install in ~/.npm-global..." >&2
    (cd "$pkg" && node install.cjs >/dev/null 2>&1) \
        || echo "devbox: repair failed; run: rm -rf ~/.npm-global/lib/node_modules/@anthropic-ai ~/.npm-global/bin/claude" >&2
}

heal
real=$(devbox_next claude) || exit 127
case "${1:-}" in
    update|upgrade)
        "$real" "$@"; rc=$?
        heal
        exit "$rc" ;;
esac
exec "$real" "$@"
